@page "/community/{CommunityId:int}"
@rendermode InteractiveServer
@implements IDisposable
@using microblog_heads.Models
@inject CommunityService CommunityService
@inject DisplayService DisplayService
@inject UserService UserService
@inject CurrentUserState CurrentUser
@inject PostService PostService
@inject CommentService CommentService
@inject NavigationManager Navigation

@inject DarkModeService DarkModeService
@inject MissuseService MissuseService

@* All posts in one community, newest first. Reached by clicking a community name on a post. *@

<PageTitle>@(community?.Name ?? "Community")</PageTitle>

<div class="feed mx-auto">
    @if (isLoading)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-secondary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-4">@errorMessage</div>
    }
    else if (community is null)
    {
        <div class="alert alert-warning mt-4">That community doesn't exist.</div>
    }
    else
    {
        <section class="card shadow-sm mb-4">
            <div class="card-body p-4 d-flex align-items-start gap-3">
                <div class="avatar avatar-md" aria-hidden="true">@community.Name.FirstOrDefault()</div>
                <div class="min-w-0 flex-fill">
                    <h1 class="h3 mb-1">@community.Name</h1>
                    @if (community.IsPrivate)
                    {
                        <span class="badge rounded-pill text-bg-secondary mb-2">🔒 Private</span>
                    }
                    <p class="mb-2 community-description">@community.Description</p>
                    <div class="text-muted small">@posts.Count @(posts.Count == 1 ? "post" : "posts"), newest first</div>

                    @if (CurrentUser.IsLoggedIn)
                    {
                        <div class="mt-3">
                            @if (myRole is not null)
                            {
                                @* There's no leave-community service yet, so membership is shown, not toggled. *@
                                <span class="badge rounded-pill member-badge">✓ Member · @myRole</span>
                            }
                           else if (hasPendingRequest)
                            {
                                <span class="badge rounded-pill text-bg-light border">⏳ Request pending</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary rounded-pill join-btn" disabled="@isJoining"
                                        @onclick="JoinAsync">
                                    @(isJoining ? "Working..." : community.IsPrivate ? "Request to join" : "Join")
                                </button>
                            }
                            @if (!string.IsNullOrEmpty(joinError))
                            {
                                <div class="text-danger small mt-1">@joinError</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
        @if (myRole is not null)
        {
            <PostComposer CommunityId="CommunityId" OnPosted="LoadAsync" />
        }
        @if (IsStaff && pendingRequests.Count > 0)
        {
            <section class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Join requests (@pendingRequests.Count)</h2>

                    @if (requestError is not null)
                    {
                        <div class="alert alert-danger py-2">@requestError</div>
                    }

                    <ul class="list-group list-group-flush">
                        @foreach (var req in pendingRequests)
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 px-0" @key="req.Id">
                                <a href="profile/@req.RegularUser.Username" class="author-link flex-fill">
                                    <strong>@req.RegularUser.FirstName @req.RegularUser.LastName</strong>
                                    <span class="text-muted">@@@req.RegularUser.Username</span>
                                </a>
                                <button type="button" class="btn btn-primary btn-sm"
                                        disabled="@(handlingRequestId == req.Id)"
                                        @onclick="() => ApproveAsync(req.Id)">Approve</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        disabled="@(handlingRequestId == req.Id)"
                                        @onclick="() => RejectAsync(req.Id)">Reject</button>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }
        @if (IsStaff && (postReports.Count > 0 || commentReports.Count > 0))
        {
            <section class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3">Reports (@(postReports.Count + commentReports.Count))</h2>

                    @if (reportError is not null)
                    {
                        <div class="alert alert-danger py-2">@reportError</div>
                    }

                    @foreach (var g in postReports)
                    {
                        <div class="border rounded p-3 mb-2" @key="@($"p{g.Post.Id}")">
                            <div class="d-flex align-items-start gap-2">
                                <div class="flex-fill">
                                    <strong>Post by @@@g.Post.RegularUser.Username</strong>
                                    <span class="badge bg-danger ms-2">@g.ReportCount @(g.ReportCount == 1 ? "report" : "reports")</span>
                                    <p class="mb-1 mt-1" style="white-space: pre-wrap">@Snip(g.Post.Content)</p>
                                    <ul class="small text-muted mb-0 ps-3">
                                        @foreach (var r in g.Reports)
                                        {
                                            <li>@@@r.RegularUser.Username: <strong>@r.MissuseName</strong> @r.MissuseDescription</li>
                                        }
                                    </ul>
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    <a class="btn btn-sm btn-info" href="post/@g.Post.Id">View</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DismissPostAsync(g.Post.Id)">Dismiss</button>
                                </div>
                            </div>
                        </div>
                    }

                    @foreach (var g in commentReports)
                    {
                        <div class="border rounded p-3 mb-2" @key="@($"c{g.Comment.Id}")">
                            <div class="d-flex align-items-start gap-2">
                                <div class="flex-fill">
                                    <strong>Comment by @@@g.Comment.RegularUser.Username</strong>
                                    <span class="badge bg-danger ms-2">@g.ReportCount @(g.ReportCount == 1 ? "report" : "reports")</span>
                                    <p class="mb-1 mt-1" style="white-space: pre-wrap">@Snip(g.Comment.Content)</p>
                                    <ul class="small text-muted mb-0 ps-3">
                                        @foreach (var r in g.Reports)
                                        {
                                            <li>@@@r.RegularUser.Username: <strong>@r.MissuseName</strong> @r.MissuseDescription</li>
                                        }
                                    </ul>
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    <a class="btn btn-sm btn-info" href="post/@g.Comment.PostId">View</a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DismissCommentAsync(g.Comment.Id)">Dismiss</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Members (@members.Count)</h2>

                @if (roleError is not null)
                {
                    <div class="alert alert-danger py-2">@roleError</div>
                }

                <ul class="list-group list-group-flush">
                    @foreach (var m in members)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 px-0" @key="m.Id">
                            <a href="profile/@m.RegularUser.Username" class="author-link flex-fill">
                                <strong>@m.RegularUser.FirstName @m.RegularUser.LastName</strong>
                                <span class="text-muted">@@@m.RegularUser.Username</span>
                            </a>

                            @if (myRole == "Admin")
                            {
                                <select class="form-select form-select-sm" style="width: auto" value="@m.CommunityRole.Role"
                                        disabled="@(changingRoleFor == m.RegularUserId)"
                                        @onchange="e => ChangeRoleAsync(m, e.Value?.ToString() ?? m.CommunityRole.Role)">
                                    @foreach (var r in roleOptions)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            }
                            @if (CurrentUser.User is { } viewer)
                            {
                                @if (m.RegularUserId == viewer.Id)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            disabled="@(removingUserId == m.RegularUserId)"
                                            @onclick="() => RemoveAsync(m)">Leave</button>
                                }
                                else if (IsStaff && (myRole == "Admin" || m.CommunityRole.Role != "Admin"))
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            disabled="@(removingUserId == m.RegularUserId)"
                                            @onclick="() => RemoveAsync(m)">Remove</button>
                                }
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-light border">@m.CommunityRole.Role</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
        @if (posts.Count == 0)
        {
            <div class="text-muted text-center py-5 border rounded bg-light">
                No posts in @community.Name yet.
            </div>
        }
        else
        {
            @foreach (var post in posts)
            {
                var authorId = post.RegularUserId;
                <PostCard Post="post" @key="post.Id" LikedPostIds="likedPostIds" LikedCommentIds="likedCommentIds"
                          IsFollowingAuthor="followingIds.Contains(authorId)"
                          OnFollowToggled="following => SetFollowing(authorId, following)"
                      OnDeleted="() => PostCard.RemoveDeleted(posts, post.Id)" />
            }
        }
    }
</div>

@code {
    [Parameter] public int CommunityId { get; set; }

    private Community? community;
    private List<Post> posts = new();
    private readonly HashSet<int> followingIds = new(); // users the signed-in user follows
    private readonly HashSet<int> likedPostIds = new(); // posts the signed-in user liked
    private readonly HashSet<int> likedCommentIds = new(); // comments the signed-in user liked
    private bool isLoading = true;
    private string? errorMessage;
    private string? myRole; // signed-in user's role here (Admin/Moderator/Follower), null if not a member
    private bool isJoining;
    private string? joinError;
    private List<CommunityUserRole> members = new();
    private readonly string[] roleOptions = { "Admin", "Moderator", "Follower" };
    private int? changingRoleFor; // RegularUserId of the member being changed
    private string? roleError;
    private int? removingUserId;
    private bool hasPendingRequest;
    private List<CommunityJoinRequest> pendingRequests = new();
    private int? handlingRequestId;
    private string? requestError;
    private List<GroupedPostReport> postReports = new();
    private List<GroupedCommentReport> commentReports = new();
    private string? reportError;
    private bool IsStaff => myRole == "Admin" || myRole == "Moderator";    



    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnCurrentUserChanged;
    }


    protected override async Task OnParametersSetAsync()
    {
        // Runs again when moving between communities without leaving this page.
        if (CurrentUser.IsInitialized)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Who is signed in lives in browser storage, which is only readable once interactive.
        // Finishing initialization raises Changed, which triggers the load (OnCurrentUserChanged).
        if (firstRender && !CurrentUser.IsInitialized)
        {
            await CurrentUser.InitializeAsync();
        }
        await DarkModeService.ApplyDarkModeAsync();
    }
    private async Task LoadMembersAsync() =>
    members = await CommunityService.GetCommunityMembersAsync(CommunityId);

    private async Task LoadRequestsAsync(int myId)
    {
        hasPendingRequest = false;
        pendingRequests = new();

        if (myRole is null)
            hasPendingRequest = await CommunityService.HasPendingRequestAsync(myId, CommunityId);
        else if (IsStaff)
            pendingRequests = await CommunityService.GetPendingRequestsAsync(myId, CommunityId);            
    }
    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        // Only logged-in users can see community pages; everyone else goes to the login page.
        if (CurrentUser.User is null)
        {
            Navigation.NavigateTo("login", replace: true);
            return;
        }

        try
        {
            community = await CommunityService.GetCommunityByIdAsync(CommunityId);
            posts = community is null ? new() : await DisplayService.GetPostsCommunityIDAsync(CommunityId);

            followingIds.Clear();
            myRole = null;
            joinError = null;
            if (CurrentUser.User is { } me)
            {
                followingIds.UnionWith((await UserService.GetFollowingAsync(me.Id)).Select(u => u.Id));
                await LoadLikesAsync(me.Id);
                myRole = await GetMyRoleAsync(me.Id);
                await LoadMembersAsync();
                await LoadRequestsAsync(me.Id);
                await LoadReportsAsync(me.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Couldn't load this community: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<string?> GetMyRoleAsync(int userId) =>
        (await CommunityService.GetCommunityRolesByUserIdAsync(userId))
            .FirstOrDefault(r => r.CommunityId == CommunityId)?.CommunityRole.Role;

    private async Task JoinAsync()
    {
        if (CurrentUser.User is not { } me) return;

        isJoining = true;
        joinError = null;
        try
        {
            var joined = await CommunityService.JoinCommunityAsync(me.Id, CommunityId);
            if (joined)
            {
                myRole = await GetMyRoleAsync(me.Id);
                await LoadMembersAsync();
            }
            else
            {
                hasPendingRequest = true;
            }
        }
        catch (Exception ex)
        {
            joinError = ex.Message;
        }
        finally
        {
            isJoining = false;
        }
    }
    private void SetFollowing(int authorId, bool following)
    {
        // Updates every card by this author, not just the one that was clicked.
        if (following)
        {
            followingIds.Add(authorId);
        }
        else
        {
            followingIds.Remove(authorId);
        }
    }

    /// <summary>Loads what the signed-in user has liked, so hearts show as liked after a reload or a new login.</summary>
    private async Task LoadLikesAsync(int myId)
    {
        likedPostIds.Clear();
        likedPostIds.UnionWith(await PostService.GetLikedPostIdsByUserIdAsync(myId));
        likedCommentIds.Clear();
        likedCommentIds.UnionWith(await CommentService.GetLikedCommentIdsByUserIdAsync(myId));
    }

    private void OnCurrentUserChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        CurrentUser.Changed -= OnCurrentUserChanged;
    }

    private async Task ChangeRoleAsync(CommunityUserRole member, string newRole)
    {
        if (CurrentUser.User is not { } me) return;

        changingRoleFor = member.RegularUserId;
        roleError = null;
        try
        {
            await CommunityService.AssignRoleAsync(me.Id, CommunityId, member.RegularUserId, newRole);
            myRole = await GetMyRoleAsync(me.Id); // in case you changed your own role
        }
        catch (Exception ex)
        {
            roleError = ex.Message; // e.g. "A community must keep at least one admin."
        }
        finally
        {
            await LoadMembersAsync(); // reload either way, so the dropdown shows the real role
            changingRoleFor = null;
        }
    }

    private async Task ApproveAsync(int requestId)
    {
        if (CurrentUser.User is not { } me) return;

        handlingRequestId = requestId;
        requestError = null;
        try
        {
            await CommunityService.ApproveRequestAsync(me.Id, requestId);
        }
        catch (Exception ex)
        {
            requestError = ex.Message;
        }
        finally
        {
            await LoadMembersAsync();
            await LoadRequestsAsync(me.Id);
            handlingRequestId = null;
        }
    }

    private async Task RejectAsync(int requestId)
    {
        if (CurrentUser.User is not { } me) return;

        handlingRequestId = requestId;
        requestError = null;
        try
        {
            await CommunityService.RejectRequestAsync(me.Id, requestId);
        }
        catch (Exception ex)
        {
            requestError = ex.Message;
        }
        finally
        {
            await LoadRequestsAsync(me.Id);
            handlingRequestId = null;
        }
    }
    private async Task RemoveAsync(CommunityUserRole member)
    {
        if (CurrentUser.User is not { } me) return;

        removingUserId = member.RegularUserId;
        roleError = null;
        try
        {
            await CommunityService.RemoveMemberAsync(me.Id, CommunityId, member.RegularUserId);

            if (member.RegularUserId == me.Id)
                await LoadAsync();  
            else
                await LoadMembersAsync();
        }
        catch (Exception ex)
        {
            roleError = ex.Message;
        }
        finally
        {
            removingUserId = null;
        }
    }
    private async Task LoadReportsAsync(int myId)
    {
        postReports = new();
        commentReports = new();
        if (!IsStaff) return;

        postReports = await MissuseService.GetGroupedPostReportsForCommunityAsync(myId, CommunityId);
        commentReports = await MissuseService.GetGroupedCommentReportsForCommunityAsync(myId, CommunityId);
    }

    private async Task DismissPostAsync(int postId)
    {
        if (CurrentUser.User is not { } me) return;
        reportError = null;
        try { await MissuseService.DismissCommunityPostReportsAsync(me.Id, postId); }
        catch (Exception ex) { reportError = ex.Message; }
        finally { await LoadReportsAsync(me.Id); }
    }

    private async Task DismissCommentAsync(int commentId)
    {
        if (CurrentUser.User is not { } me) return;
        reportError = null;
        try { await MissuseService.DismissCommunityCommentReportsAsync(me.Id, commentId); }
        catch (Exception ex) { reportError = ex.Message; }
        finally { await LoadReportsAsync(me.Id); }
    }

    private static string Snip(string text) => text.Length <= 100 ? text : text[..100] + "...";
}
