@page "/following"
@rendermode InteractiveServer
@implements IDisposable
@using microblog_heads.Models
@inject DisplayService DisplayService
@inject UserService UserService
@inject CurrentUserState CurrentUser
@inject PostService PostService
@inject CommentService CommentService
@inject NavigationManager Navigation

@* Posts from everything the signed-in user follows: people, communities, hashtags and
   individual posts (DisplayService.GetAllFollowingPostsbyUserIDAsync), newest first. *@

<PageTitle>Following</PageTitle>

<div class="feed mx-auto">
    <h1 class="h3 mb-1">Following</h1>
    <p class="text-muted small mb-3">Posts from the people, communities and hashtags you follow, newest first.</p>

    @* Logged-out users are redirected to /login, so they only see the spinner briefly. *@
    @if (!CurrentUser.IsInitialized || !CurrentUser.IsLoggedIn || isLoading)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-secondary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (posts.Count == 0)
    {
        <div class="text-muted text-center py-5 border rounded bg-light">
            <p class="mb-2">Nothing here yet. Posts show up once you follow people, communities or hashtags.</p>
            <a href="">Find people to follow on For You</a>
        </div>
    }
    else
    {
        @foreach (var post in posts)
        {
            var authorId = post.RegularUserId;
            <PostCard Post="post" @key="post.Id" LikedPostIds="likedPostIds" LikedCommentIds="likedCommentIds"
                      IsFollowingAuthor="followingIds.Contains(authorId)"
                      OnFollowToggled="following => SetFollowing(authorId, following)" />
        }
    }
</div>

@code {
    private List<Post> posts = new();
    private readonly HashSet<int> followingIds = new(); // users the signed-in user follows
    private readonly HashSet<int> likedPostIds = new();    // posts the signed-in user liked
    private readonly HashSet<int> likedCommentIds = new(); // comments the signed-in user liked
    private bool isLoading;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnCurrentUserChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // If another component already restored the signed-in user in this circuit, load now.
        if (CurrentUser.IsInitialized)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Who is signed in lives in browser storage, which is only readable once interactive.
        // Finishing initialization raises Changed, which triggers the load (OnCurrentUserChanged).
        if (firstRender && !CurrentUser.IsInitialized)
        {
            await CurrentUser.InitializeAsync();
        }
    }

    private async Task LoadAsync()
    {
        errorMessage = null;

        if (CurrentUser.User is not { } user)
        {
            posts = new();
            Navigation.NavigateTo("login", replace: true);
            return;
        }

        isLoading = true;
        try
        {
            posts = await DisplayService.GetAllFollowingPostsbyUserIDAsync(user.Id);

            followingIds.Clear();
            followingIds.UnionWith((await UserService.GetFollowingAsync(user.Id)).Select(u => u.Id));
            await LoadLikesAsync(user.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Couldn't load your feed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFollowing(int authorId, bool following)
    {
        // Updates every card by this author. Their posts stay listed until the page is reloaded.
        if (following)
        {
            followingIds.Add(authorId);
        }
        else
        {
            followingIds.Remove(authorId);
        }
    }

    /// <summary>Loads what the signed-in user has liked, so hearts show as liked after a reload or a new login.</summary>
    private async Task LoadLikesAsync(int myId)
    {
        likedPostIds.Clear();
        likedPostIds.UnionWith(await PostService.GetLikedPostIdsByUserIdAsync(myId));
        likedCommentIds.Clear();
        likedCommentIds.UnionWith(await CommentService.GetLikedCommentIdsByUserIdAsync(myId));
    }

    private void OnCurrentUserChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        CurrentUser.Changed -= OnCurrentUserChanged;
    }
}
