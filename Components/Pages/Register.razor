@page "/register"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject UserService UserService
@inject CurrentUserState CurrentUser
@inject NavigationManager Navigation

<PageTitle>Create account</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="auth-header">
                    <span class="auth-mark" aria-hidden="true">mh</span>
                    <h1 class="h3 mb-1">Create your account</h1>
                    <p class="text-muted mb-0">Join Microblog Heads and start posting.</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <EditForm Model="model" OnValidSubmit="HandleRegisterAsync" FormName="register">
                    <DataAnnotationsValidator />

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label for="firstName" class="form-label">First name</label>
                            <InputText id="firstName" class="form-control" @bind-Value="model.FirstName" autocomplete="given-name" />
                            <ValidationMessage For="() => model.FirstName" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label for="lastName" class="form-label">Last name</label>
                            <InputText id="lastName" class="form-control" @bind-Value="model.LastName" autocomplete="family-name" />
                            <ValidationMessage For="() => model.LastName" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" type="email" class="form-control" @bind-Value="model.Email" autocomplete="email" />
                        <ValidationMessage For="() => model.Email" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <InputText id="username" class="form-control" @bind-Value="model.Username" autocomplete="username" />
                        <ValidationMessage For="() => model.Username" class="text-danger small" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label for="password" class="form-label">Password</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="new-password" />
                            <ValidationMessage For="() => model.Password" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label for="confirmPassword" class="form-label">Confirm password</label>
                            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="model.ConfirmPassword" autocomplete="new-password" />
                            <ValidationMessage For="() => model.ConfirmPassword" class="text-danger small" />
                        </div>
                    </div>

                    @* Disabled until the interactive circuit is connected; otherwise the browser
                       would do a plain HTML form post and the entered values would be lost. *@
                    <button type="submit" class="btn btn-primary w-100" disabled="@(!RendererInfo.IsInteractive || isSubmitting)">
                        @(!RendererInfo.IsInteractive ? "Loading..." : isSubmitting ? "Creating account..." : "Create account")
                    </button>
                </EditForm>

                <p class="mt-4 mb-0 text-center">
                    Already have an account? <a href="login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly RegisterModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUser.InitializeAsync(); // no-op if already restored
            if (CurrentUser.IsLoggedIn)
            {
                Navigation.NavigateTo("", replace: true); // already logged in: go to For You
            }
        }
    }

    private async Task HandleRegisterAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            var username = model.Username.Trim();

            // Throws "That username is already taken." / "An account with that email
            // already exists." for duplicates; shown below via errorMessage.
            await UserService.CreateUserAccountAsync(
                firstName: model.FirstName.Trim(),
                lastName: model.LastName.Trim(),
                email: model.Email.Trim(),
                username: username,
                password: model.Password);

            // Sign the new user in right away.
            await CurrentUser.LoginAsync(username, model.Password);
            Navigation.NavigateTo("");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "First name is required.")]
        [StringLength(50)]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Last name is required.")]
        [StringLength(50)]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(50)]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Username is required.")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Username must be 3–50 characters.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(50, MinimumLength = 6, ErrorMessage = "Password must be 6–50 characters.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
