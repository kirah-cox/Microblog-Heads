@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject CurrentUserState CurrentUser
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4 text-center">Log in</h1>

                @if (CurrentUser.IsLoggedIn)
                {
                    <div class="alert alert-info">
                        You are signed in as <strong>@CurrentUser.User!.Username</strong>.
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary flex-fill" href="">Go home</a>
                        <button class="btn btn-outline-secondary flex-fill" @onclick="LogoutAsync">Log out</button>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }

                    <EditForm Model="model" OnValidSubmit="HandleLoginAsync" FormName="login">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <InputText id="username" class="form-control" @bind-Value="model.Username" autocomplete="username" />
                            <ValidationMessage For="() => model.Username" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Password</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
                            <ValidationMessage For="() => model.Password" class="text-danger small" />
                        </div>

                        @* Disabled until the interactive circuit is connected; otherwise the browser
                           would do a plain HTML form post and the entered values would be lost. *@
                        <button type="submit" class="btn btn-primary w-100" disabled="@(!RendererInfo.IsInteractive || isSubmitting)">
                            @(!RendererInfo.IsInteractive ? "Loading..." : isSubmitting ? "Logging in..." : "Log in")
                        </button>
                    </EditForm>

                    <p class="mt-4 mb-0 text-center">
                        Don't have an account? <a href="register">Create one</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !CurrentUser.IsInitialized)
        {
            await CurrentUser.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task HandleLoginAsync()
    {
        errorMessage = null;
        isSubmitting = true;
        try
        {
            await CurrentUser.LoginAsync(model.Username.Trim(), model.Password);
            Navigation.NavigateTo("");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LogoutAsync()
    {
        await CurrentUser.LogoutAsync();
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = "";
    }
}
