@implements IDisposable
@inject CurrentUserState CurrentUser
@inject NavigationManager Navigation

@if (CurrentUser.IsLoggedIn)
{
    <span class="text-muted">Signed in as <a href="profile" class="fw-semibold ms-0">@CurrentUser.User!.Username</a></span>
    <button class="btn btn-link p-0" @onclick="LogoutAsync">Log out</button>
}
else if (CurrentUser.IsInitialized)
{
    <a href="login">Log in</a>
    <a href="register">Create account</a>
}

@code {
    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnUserChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUser.InitializeAsync();
        }
    }

    private async Task LogoutAsync()
    {
        await CurrentUser.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void OnUserChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CurrentUser.Changed -= OnUserChanged;
    }
}
