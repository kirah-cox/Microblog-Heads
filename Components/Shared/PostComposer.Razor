@inject PostService PostService
@inject MediaService MediaService
@inject CurrentUserState CurrentUser

@if (CurrentUser.User is { } me)
{
    <div class="card mb-3">
        <div class="card-body">
            <textarea class="form-control" rows="3" placeholder="@Placeholder"
                      @bind="text" @bind:event="oninput"></textarea>

            @if (OriginalPostId is null)
            {
                <div class="mt-2">
                    @foreach (var tag in hashTags)
                    {
                        <div @key="tag" class="input-group input-group-sm mb-1">
                            <span class="input-group-text">#</span>
                            <input type="text" class="form-control" placeholder="hashtag" maxlength="50"
                                   @bind="tag.Value" @bind:event="oninput" />
                            <button type="button" class="btn btn-outline-secondary" title="Remove hashtag"
                                    @onclick="() => RemoveHashTag(tag)">&times;</button>
                        </div>
                    }
                    @if (hashTags.Count < MaxHashTags)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="AddHashTag">+ Add another hashtag</button>
                    }
                </div>

                <InputFile @key="inputKey" OnChange="OnFilesChosen" multiple
                           accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.webm"
                           class="form-control form-control-sm mt-2" />
                @if (files.Count > 0)
                {
                    <ul class="small text-muted mb-0 mt-1">
                        @foreach (var f in files)
                        {
                            <li>@f.Name (@(f.Size / 1024) KB)</li>
                        }
                    </ul>
                }
            }

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="@(text.Length > 500 ? "text-danger" : "text-muted")">@text.Length / 500</small>
                <button type="button" class="btn btn-primary btn-sm" disabled="@isSaving" @onclick="SubmitAsync">
                    @(isSaving ? "Posting..." : ButtonText)
                </button>
            </div>
            @if (error is not null)
            {
                <div class="text-danger small mt-1">@error</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? CommunityId { get; set; }
    [Parameter] public int? OriginalPostId { get; set; }   // set = this is a repost
    [Parameter] public string Placeholder { get; set; } = "What's happening?";
    [Parameter] public string ButtonText { get; set; } = "Post";
    [Parameter] public EventCallback OnPosted { get; set; }

    private string text = "";
    private string? error;
    private bool isSaving;
    private List<IBrowserFile> files = new();
    private int inputKey;   // changing this key makes Blazor build a fresh, empty file picker

    private const int MaxHashTags = 10;
    private List<HashTagInput> hashTags = new() { new() };

    // A class (not a plain string) so each box keeps its identity for @key when one is removed.
    private class HashTagInput
    {
        public string Value { get; set; } = "";
    }

    private void AddHashTag() => hashTags.Add(new());

    private void RemoveHashTag(HashTagInput tag)
    {
        hashTags.Remove(tag);
        if (hashTags.Count == 0) hashTags.Add(new());   // always keep one empty box
    }

    private void OnFilesChosen(InputFileChangeEventArgs e)
    {
        error = null;
        var chosen = e.GetMultipleFiles(20);
        if (chosen.Count > MediaService.MaxFilesPerPost)
        {
            error = $"You can attach up to {MediaService.MaxFilesPerPost} files.";
            files = new();
            return;
        }
        files = chosen.ToList();
    }

    private async Task SubmitAsync()
    {
        if (CurrentUser.User is not { } me) return;

        error = null;
        isSaving = true;
        var saved = new List<string>();
        var succeeded = false;
        try
        {
            foreach (var f in files)
            {
                await using var stream = f.OpenReadStream(MediaService.MaxVideoBytes);
                saved.Add(await MediaService.SaveFileAsync(stream, f.Name, f.Size));
            }

            if (OriginalPostId is int original)
                await PostService.CreateRepostAsync(me.Id, original, text, CommunityId);
            else
                await PostService.CreatePostAsync(me.Id, text, CommunityId, saved,
                    hashTags.Select(t => t.Value));

            text = "";
            files = new();
            hashTags = new() { new() };
            inputKey++;
            succeeded = true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IOException)
        {
            foreach (var name in saved) MediaService.DeleteFile(name);   // don't leave orphans
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }

        if (succeeded) await OnPosted.InvokeAsync();
    }
}